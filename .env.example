# GreenAI Environment Configuration Template
# Copy this file to .env and fill in your values

# ====================
# DATABASE (Required)
# ====================
# Supabase Postgres connection string
DATABASE_URL=postgresql://postgres.[your-project-ref]:[your-password]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres

# ====================
# AUTHENTICATION (Required)
# ====================
# JWT configuration
JWT_SECRET_KEY=your-32-char-minimum-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ====================
# SUPABASE (Required)
# ====================
SUPABASE_URL=https://[your-project-ref].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ====================
# REDIS (Phase 4.4 - Celery Workers)
# ====================
# Redis URL for Celery message broker and result backend
# Local Redis: redis://localhost:6379/0
# Remote Redis: redis://username:password@host:port/db
REDIS_URL=redis://localhost:6379/0

# ====================
# CELERY WORKERS (Phase 4.4)
# ====================
# Sync compute mode (default: true) - processes emissions synchronously
# Set to "false" to use Celery workers for async processing
SYNC_COMPUTE=true

# Celery configuration (required only if SYNC_COMPUTE=false)
# Broker URL: Where Celery sends tasks
# Result Backend: Where Celery stores task results
# Usually both use the same Redis instance
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ====================
# APPLICATION
# ====================
ENVIRONMENT=development

# ====================
# SECURITY
# ====================
# Comma-separated list of allowed CORS origins
# Development: Include all local frontend URLs
# Production: Include only production frontend domain
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# For production: ALLOWED_ORIGINS=https://your-frontend-domain.com

# ====================
# FRONTEND (Required)
# ====================
NEXT_PUBLIC_API_BASE=http://localhost:8001/api
# For production: NEXT_PUBLIC_API_BASE=https://your-backend.railway.app/api

# Frontend URL (used by backend to build password-reset email links)
FRONTEND_URL=http://localhost:3000
# For production: FRONTEND_URL=https://your-frontend.vercel.app

# ====================
# PAYMENTS (Optional - for subscription billing)
# ====================
# Razorpay credentials (get from https://dashboard.razorpay.com/)
# RAZORPAY_KEY_ID=your-razorpay-key-id
# RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ====================
# EMAIL NOTIFICATIONS (Phase 4.3)
# ====================
# Console mode (default: true) - logs emails to console for testing
# Set to "false" to use SendGrid for real email delivery
EMAIL_CONSOLE_MODE=true

# SendGrid credentials (required only if EMAIL_CONSOLE_MODE=false)
# Get API key from https://app.sendgrid.com/settings/api_keys
# SENDGRID_API_KEY=SG.your-sendgrid-api-key
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ====================
# CLOUD STORAGE (Phase 4.2 - Google Cloud Storage)
# ====================
# Local mode (default: true) - stores files locally for testing
# Set to "false" to use GCS for cloud storage
GCS_LOCAL_MODE=true

# GCS credentials (required only if GCS_LOCAL_MODE=false)
# Get from Google Cloud Console > IAM & Admin > Service Accounts
# GCS_BUCKET_NAME=greenai-reports
# GCS_PROJECT_ID=your-gcp-project-id
# GCS_CREDENTIALS_PATH=/path/to/service-account-key.json

# ====================
# LEGACY STORAGE (Deprecated - use GCS instead)
# ====================
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_BUCKET=greenai-reports
